[Unit]
Description=Apache NiFi 2.12.0
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=nifi
Group=nifi
WorkingDirectory=/opt/nifi/nifi-2.12.0
Environment="JAVA_HOME=/usr/lib/jvm/java-21-openjdk-arm64"
ExecStart=/opt/nifi/nifi-2.12.0/bin/nifi.sh run
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=50000

[Install]
WantedBy=multi-user.target
