# Mẫu /etc/nt132-api/api.env (file thật: root:nifi-source-api, mode 0640, KHÔNG commit).
# install.sh tự sinh key ngẫu nhiên bằng: openssl rand -hex 32
NT132_API_KEY=<API_KEY_64_HEX>
NT132_API_BIND=<IP_VM4>:5000
# 1 = bật /api/slow, /api/error cho test lab (TC-12); 0 khi không cần
NT132_LAB_TEST_ENDPOINTS=1
